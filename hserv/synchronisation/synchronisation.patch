+<?php
+
+namespace hserv\synchronisation;
+
+/**
+ * Shared additions-only record writer. Call inside a SyncTransaction.
+ *
+ * A snapshot is evidence of values to retain, never authority to remove values.
+ * Existing detail IDs (including file references) are left untouched. Matching
+ * uses a multiset: two identical source values remain two values, but replaying
+ * the same snapshot does not grow that count. Local IDs must be resolved first.
+ */
+final class SyncAdditiveRecord
+{
+    /** Reject truncated/malformed snapshots instead of treating missing details as empty. */
+    public static function validate(array $records): void
+    {
+        $seen = [];
+        foreach ($records as $record) {
+            if (!is_array($record) || (int)($record['rec_ID'] ?? 0) < 1
+                || !isset($record['details']) || !is_array($record['details'])) {
+                throw new \RuntimeException('An incoming record is incomplete; no change cursor may be advanced.');
+            }
+            $id = (int)$record['rec_ID'];
+            if (isset($seen[$id])) throw new \RuntimeException("Duplicate incoming record ID $id.");
+            $seen[$id] = true;
+            foreach ($record['details'] as $detail) {
+                if (!is_array($detail) || empty($detail['detailTypeConceptID']) || empty($detail['dty_Type'])
+                    || !array_key_exists('dtl_Value', $detail)) {
+                    throw new \RuntimeException("An incoming field in record $id is incomplete.");
+                }
+                if (in_array($detail['dty_Type'], ['enum', 'relationtype'], true)
+                    && (int)$detail['dtl_Value'] > 0 && empty($detail['termConceptID'])) {
+                    throw new \RuntimeException("A term in record $id has no portable concept identity.");
+                }
+                if (!empty($detail['dtl_UploadedFileID']) && empty($detail['satelliteFileID'])) {
+                    throw new \RuntimeException("A file in record $id has no portable file identity.");
+                }
+            }
+        }
+    }
+
+    /** Lock before comparing, serialising sync writers and normal record-header saves. */
+    public static function lock(\mysqli $mysqli, int $recordID): array
+    {
+        $result = $mysqli->query('SELECT * FROM Records WHERE rec_ID='.$recordID.' FOR UPDATE');
+        if (!$result) throw new \RuntimeException('Unable to lock synchronised record: '.$mysqli->error);
+        $row = $result->fetch_assoc();
+        $result->close();
+        if (!$row) throw new \RuntimeException("Synchronised record $recordID no longer exists.");
+        return $row;
+    }
+
+    /** Fill reservations; for established records only fill empty descriptive headers. */
+    public static function header(\mysqli $mysqli, array $record): void
+    {
+        $id = (int)$record['rec_ID'];
+        $current = self::lock($mysqli, $id);
+        $updates = [];
+        $temporary = (int)$current['rec_FlagTemporary'] === 1;
+        foreach (['rec_URL', 'rec_Title', 'rec_ScratchPad', 'rec_Added', 'rec_AddedByImport', 'rec_NonOwnerVisibility'] as $column) {
+            if (!array_key_exists($column, $record)) continue;
+            $incoming = $record[$column];
+            if ($temporary || (in_array($column, ['rec_URL', 'rec_Title', 'rec_ScratchPad'], true)
+                && ($current[$column] === null || $current[$column] === '') && $incoming !== null && $incoming !== '')) {
+                $updates[] = '`'.$column.'`='.($incoming === null ? 'NULL' : "'".$mysqli->real_escape_string((string)$incoming)."'");
+            }
+        }
+        if ($temporary) $updates[] = 'rec_FlagTemporary=0';
+        if ($updates && !$mysqli->query('UPDATE Records SET '.implode(',', $updates)
+            .',rec_Modified=UTC_TIMESTAMP() WHERE rec_ID='.$id)) {
+            throw new \RuntimeException("Unable to fill record $id: ".$mysqli->error);
+        }
+    }
+
+    /** Exact stored value and metadata identity; SQL numeric strings are normalised. */
+    public static function key(array $detail): string
+    {
+        return hash('sha256', serialize([
+            (int)$detail['dtl_DetailTypeID'],
+            isset($detail['dtl_Value']) ? (string)$detail['dtl_Value'] : null,
+            empty($detail['dtl_UploadedFileID']) ? null : (int)$detail['dtl_UploadedFileID'],
+            $detail['dtl_Geo'] ?? null,
+            isset($detail['dtl_Certainty']) ? (float)$detail['dtl_Certainty'] : null,
+            $detail['dtl_Annotation'] ?? null,
+            isset($detail['dtl_HideFromPublic']) ? (int)$detail['dtl_HideFromPublic'] : null
+        ]));
+    }
+
+    /** Append missing occurrences without updating/deleting any existing detail row. */
+    public static function details(\mysqli $mysqli, int $recordID, array $details, ?callable $onInsertError = null): int
+    {
+        self::lock($mysqli, $recordID);
+        $result = $mysqli->query('SELECT dtl_DetailTypeID,dtl_Value,dtl_UploadedFileID,ST_AsText(dtl_Geo) AS dtl_Geo,'
+            .'dtl_Certainty,dtl_Annotation,dtl_HideFromPublic FROM recDetails WHERE dtl_RecID='.$recordID.' FOR UPDATE');
+        if (!$result) throw new \RuntimeException('Unable to read existing record fields: '.$mysqli->error);
+        $available = [];
+        while ($row = $result->fetch_assoc()) {
+            $key = self::key($row);
+            $available[$key] = ($available[$key] ?? 0) + 1;
+        }
+        $result->close();
+        $added = 0;
+        foreach ($details as $detail) {
+            $key = self::key($detail);
+            if (($available[$key] ?? 0) > 0) { $available[$key]--; continue; }
+            $stmt = $mysqli->prepare('INSERT INTO recDetails '
+                .'(dtl_RecID,dtl_DetailTypeID,dtl_Value,dtl_UploadedFileID,dtl_Geo,dtl_Certainty,dtl_Annotation,dtl_HideFromPublic,dtl_AddedByImport) '
+                .'VALUES (?,?,?,?,IF(? IS NULL,NULL,ST_GeomFromText(?)),?,?,?,1)');
+            if (!$stmt) throw new \RuntimeException('Unable to prepare additive field insert: '.$mysqli->error);
+            $dtyID = (int)$detail['dtl_DetailTypeID']; $value = $detail['dtl_Value'] ?? null;
+            $fileID = $detail['dtl_UploadedFileID'] ?? null; $geo = $detail['dtl_Geo'] ?? null;
+            $certainty = isset($detail['dtl_Certainty']) ? (float)$detail['dtl_Certainty'] : null;
+            $annotation = $detail['dtl_Annotation'] ?? null; $hidden = $detail['dtl_HideFromPublic'] ?? null;
+            $stmt->bind_param('iisissdsi', $recordID, $dtyID, $value, $fileID, $geo, $geo, $certainty, $annotation, $hidden);
+            try {
+                if (!$stmt->execute()) throw new \RuntimeException("Unable to append field $dtyID to record $recordID: ".$stmt->error);
+            } catch (\Throwable $error) {
+                // Preserve caller-specific field and record diagnostics before rollback.
+                if ($onInsertError !== null) $onInsertError($detail, $stmt->errno, $stmt->error ?: $error->getMessage());
+                throw $error;
+            } finally { $stmt->close(); }
+            $added++;
+        }
+        if ($added > 0 && !$mysqli->query('UPDATE Records SET rec_Modified=UTC_TIMESTAMP() WHERE rec_ID='.$recordID)) {
+            throw new \RuntimeException('Unable to mark the synchronised record modification time.');
+        }
+        return $added;
+    }
+}
diff --git a/hserv/synchronisation/SyncFileStorage.php b/hserv/synchronisation/SyncFileStorage.php
new file mode 100644
index 0000000..d04c1bc
--- /dev/null
+++ b/hserv/synchronisation/SyncFileStorage.php
@@ -0,0 +1,27 @@
+<?php
+
+namespace hserv\synchronisation;
+
+/** Immutable writes: an interrupted attempt may leave an orphan, never damage a referenced file. */
+final class SyncFileStorage
+{
+    /** Exclusively create a fresh file, check every byte and flush it before returning its stored name. */
+    public static function store(string $directory, string $prefix, string $extension, string $bytes): string
+    {
+        $name = $prefix.'_'.bin2hex(random_bytes(16)).($extension !== '' ? '.'.$extension : '');
+        $path = $directory.$name;
+        $handle = fopen($path, 'xb'); // Exclusive creation; never truncate an existing upload.
+        if (!$handle) throw new \RuntimeException('Unable to create a synchronised file.');
+        try {
+            $offset = 0;
+            while ($offset < strlen($bytes)) {
+                $written = fwrite($handle, substr($bytes, $offset));
+                if ($written === false || $written === 0) throw new \RuntimeException('Incomplete synchronised file write.');
+                $offset += $written;
+            }
+            if (!fflush($handle)) throw new \RuntimeException('Unable to flush synchronised file.');
+            if (function_exists('fsync') && !fsync($handle)) throw new \RuntimeException('Unable to persist synchronised file.');
+        } finally { fclose($handle); }
+        return $name;
+    }
+}
diff --git a/hserv/synchronisation/SyncTransaction.php b/hserv/synchronisation/SyncTransaction.php
new file mode 100644
index 0000000..f0162d9
--- /dev/null
+++ b/hserv/synchronisation/SyncTransaction.php
@@ -0,0 +1,60 @@
+<?php
+
+namespace hserv\synchronisation;
+
+/**
+ * Checked, exception-safe transaction boundary for synchronisation only.
+ * The general application transaction helpers discard COMMIT failures and may
+ * commit a caller's transaction when nested. Sync must fail closed instead.
+ * Always call close() in finally; only finish(true) may acknowledge a batch.
+ */
+final class SyncTransaction
+{
+    private \mysqli $mysqli;
+    private bool $active = false;
+    private $previousGuard;
+    private static array $connections = [];
+
+    /** Reject nesting, begin a repeatable-read transaction and optionally suppress only sync journalling. */
+    public function __construct(\mysqli $mysqli, bool $suppressJournal = false)
+    {
+        $this->mysqli = $mysqli;
+        $connectionID = spl_object_id($mysqli);
+        if (isset(self::$connections[$connectionID])) throw new \RuntimeException('Nested synchronisation transactions are not allowed.');
+        // MySQL/MariaDB reject SET TRANSACTION inside an active transaction;
+        // unlike START TRANSACTION, this cannot implicitly commit a caller.
+        if (!$mysqli->query('SET TRANSACTION ISOLATION LEVEL REPEATABLE READ')) {
+            throw new \RuntimeException('Cannot start a synchronisation snapshot inside an existing transaction.');
+        }
+        $this->previousGuard = mysql__select_value($mysqli, 'SELECT @HEURIST_SYNC_APPLY');
+        if (! $mysqli->begin_transaction()) throw new \RuntimeException('Unable to begin synchronisation transaction.');
+        $this->active = true;
+        self::$connections[$connectionID] = true;
+        if ($suppressJournal && !$mysqli->query('SET @HEURIST_SYNC_APPLY=1')) {
+            $this->close();
+            throw new \RuntimeException('Unable to suppress inbound synchronisation journalling.');
+        }
+    }
+
+    /** Commit only a successful stage; throw on failed commit so no acknowledgement or cursor is advanced. */
+    public function finish(bool $ok): bool
+    {
+        if (!$ok) { $this->close(); return false; }
+        if (!$this->mysqli->commit()) throw new \RuntimeException('Synchronisation commit failed; retry before advancing a cursor.');
+        $this->active = false;
+        return true;
+    }
+
+    /** Roll back an unfinished stage and restore the prior journal guard, including exceptional exits. */
+    public function close(): void
+    {
+        try {
+            if ($this->active) $this->mysqli->rollback();
+        } finally {
+            $this->active = false;
+            unset(self::$connections[spl_object_id($this->mysqli)]);
+            $value = $this->previousGuard === null ? 'NULL' : (string)(int)$this->previousGuard;
+            $this->mysqli->query('SET @HEURIST_SYNC_APPLY='.$value);
+        }
+    }
+}
diff --git a/tests/synchronisation/additive_regression.php b/tests/synchronisation/additive_regression.php
new file mode 100644
index 0000000..7d06f45
--- /dev/null
+++ b/tests/synchronisation/additive_regression.php
@@ -0,0 +1,140 @@
+<?php
+/**
+ * Behavioural regression checks for the additions-only writer.
+ * Run with php -n tests/synchronisation/additive_regression.php (no mysqli extension).
+ * The in-memory database double exercises the actual production PHP helpers.
+ * It does not substitute for MySQL integration, trigger, or concurrency testing.
+ */
+if (extension_loaded('mysqli')) {
+    fwrite(STDERR, "Run using php -n without the mysqli extension.\n");
+    exit(2);
+}
+class SyncTestResult {
+    private array $rows;
+    function __construct(array $rows) { $this->rows = $rows; }
+    function fetch_assoc() { return array_shift($this->rows); }
+    function close() {}
+}
+class mysqli {
+    public array $records = [];
+    public array $details = [];
+    public string $error = '';
+    public bool $failInsert = false;
+    public bool $failCommit = false;
+    public $guard = null;
+    public int $nextID = 1;
+    private ?array $snapshot = null;
+    function query(string $sql) {
+        if (str_starts_with($sql, 'UPDATE Records SET rec_Modified=UTC_TIMESTAMP()')) return true;
+        if ($sql === 'SET TRANSACTION ISOLATION LEVEL REPEATABLE READ') return $this->snapshot === null;
+        if (preg_match('/^SELECT \* FROM Records WHERE rec_ID=(\d+) FOR UPDATE$/', $sql, $m)) {
+            return new SyncTestResult(isset($this->records[$m[1]]) ? [$this->records[$m[1]]] : []);
+        }
+        if (str_starts_with($sql, 'SELECT dtl_DetailTypeID,dtl_Value,')) {
+            preg_match('/WHERE dtl_RecID=(\d+)/', $sql, $m);
+            return new SyncTestResult(array_values(array_filter($this->details,
+                fn($row) => $row['dtl_RecID'] == $m[1])));
+        }
+        if (preg_match('/^SET @HEURIST_SYNC_APPLY=(NULL|\d+)$/', $sql, $m)) {
+            $this->guard = $m[1] === 'NULL' ? null : (int)$m[1]; return true;
+        }
+        throw new RuntimeException('Unexpected SQL in test double: '.$sql);
+    }
+    function prepare(string $sql) {
+        if (!str_starts_with($sql, 'INSERT INTO recDetails ')) throw new RuntimeException('Unexpected prepared SQL: '.$sql);
+        return new SyncTestStatement($this);
+    }
+    function real_escape_string(string $value) { return addslashes($value); }
+    function begin_transaction() { $this->snapshot = [$this->records, $this->details]; return true; }
+    function commit() { if ($this->failCommit) return false; $this->snapshot = null; return true; }
+    function rollback() { if ($this->snapshot !== null) [$this->records, $this->details] = $this->snapshot; $this->snapshot = null; return true; }
+}
+class SyncTestStatement {
+    public string $error = '';
+    private mysqli $db;
+    private array $values = [];
+    function __construct(mysqli $db) { $this->db = $db; }
+    function bind_param($types, &...$values) { $this->values = &$values; return true; }
+    function execute() {
+        if ($this->db->failInsert) { $this->error = 'Injected write failure'; return false; }
+        [$rec,$field,$value,$file,$geo,$geo2,$certainty,$annotation,$hidden] = $this->values;
+        $this->db->details[] = [
+            'dtl_ID'=>$this->db->nextID++, 'dtl_RecID'=>$rec, 'dtl_DetailTypeID'=>$field,
+            'dtl_Value'=>$value, 'dtl_UploadedFileID'=>$file, 'dtl_Geo'=>$geo,
+            'dtl_Certainty'=>$certainty, 'dtl_Annotation'=>$annotation, 'dtl_HideFromPublic'=>$hidden
+        ];
+        return true;
+    }
+    function close() {}
+}
+function mysql__select_value(mysqli $db, $sql, $params = null) {
+    if ($sql === 'SELECT @HEURIST_SYNC_APPLY') return $db->guard;
+    throw new RuntimeException('Unexpected scalar query: '.$sql);
+}
+require_once __DIR__.'/../../hserv/synchronisation/SyncAdditiveRecord.php';
+require_once __DIR__.'/../../hserv/synchronisation/SyncTransaction.php';
+use hserv\synchronisation\SyncAdditiveRecord as Writer;
+use hserv\synchronisation\SyncTransaction;
+function check($condition, string $label): void {
+    if (!$condition) throw new RuntimeException('FAIL: '.$label);
+    echo "PASS: $label\n";
+}
+function value(string $text, ?int $file = null): array {
+    return ['dtl_DetailTypeID'=>15, 'dtl_Value'=>$text, 'dtl_UploadedFileID'=>$file,
+        'dtl_Geo'=>null, 'dtl_Certainty'=>1.0, 'dtl_Annotation'=>null, 'dtl_HideFromPublic'=>null];
+}
+$db = new mysqli();
+$db->records[88] = ['rec_ID'=>88,'rec_FlagTemporary'=>0,'rec_URL'=>'original URL',
+    'rec_Title'=>'Original record','rec_ScratchPad'=>'Local notes'];
+$image = value('', 42);
+$db->details[] = $image + ['dtl_ID'=>100,'dtl_RecID'=>88];
+check(Writer::details($db, 88, []) === 0 && $db->details[0]['dtl_UploadedFileID'] === 42,
+    'Empty source snapshot preserves existing image reference and detail ID');
+$a = value('A');
+check(Writer::details($db,88,[$a,$a]) === 2, 'Two identical incoming occurrences are retained');
+$before = $db->details;
+check(Writer::details($db,88,[$a,$a]) === 0 && $db->details === $before,
+    'Replaying the same batch adds no duplicates');
+check(Writer::details($db,88,[$a]) === 0 && count($db->details) === 3,
+    'Stale snapshot cannot reduce repeated values');
+check(Writer::details($db,88,[$image]) === 0 && $db->details[0]['dtl_ID'] === 100,
+    'Replayed image preserves original detail identity');
+$headers = $db->records;
+Writer::header($db,['rec_ID'=>88,'rec_Title'=>'Incoming title','rec_URL'=>'', 'rec_ScratchPad'=>null]);
+check($db->records === $headers, 'Existing header values survive conflicting or empty incoming values');
+$before = $db->details;
+$tx = new SyncTransaction($db,true);
+try {
+    Writer::details($db,88,[value('new value before failure')]);
+    $db->failInsert = true;
+    Writer::details($db,88,[value('must fail')]);
+    $tx->finish(true);
+    throw new RuntimeException('Expected insert failure');
+} catch (RuntimeException $e) {
+    check(str_contains($e->getMessage(),'Injected write failure'), 'Insert failure propagates');
+} finally { $tx->close(); $db->failInsert = false; }
+check($db->details === $before && $db->guard === null, 'Failure rolls back earlier additions and restores journal guard');
+$tx = new SyncTransaction($db,true);
+$db->failCommit = true;
+try {
+    Writer::details($db,88,[value('uncommitted')]);
+    $tx->finish(true);
+    throw new RuntimeException('Expected commit failure');
+} catch (RuntimeException $e) {
+    check(str_contains($e->getMessage(),'commit failed'), 'Commit failure cannot acknowledge the batch');
+} finally { $tx->close(); $db->failCommit = false; }
+check($db->details === $before && $db->guard === null, 'Failed commit leaves prior data intact in rollback model');
+try {
+    Writer::validate([['rec_ID'=>88]]);
+    throw new RuntimeException('Expected validation failure');
+} catch (RuntimeException $e) {
+    check(str_contains($e->getMessage(),'incomplete'), 'Missing detail payload is rejected');
+}
+$tx = new SyncTransaction($db, true);
+try {
+    new SyncTransaction($db);
+    throw new RuntimeException('Expected nested transaction rejection');
+} catch (RuntimeException $e) {
+    check(str_contains($e->getMessage(), 'Nested'), 'Nested transaction cannot commit its caller');
+} finally { $tx->close(); }
+echo "All additive regression checks passed.\n";
diff --git a/tests/synchronisation/config_regression.php b/tests/synchronisation/config_regression.php
