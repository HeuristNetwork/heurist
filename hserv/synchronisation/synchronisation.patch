@@ -0,0 +1,45 @@
+<?php
+/** Isolated real-filesystem config persistence checks; run with php -n. */
+namespace hserv {
+    class System {
+        public $settings;
+        public array $errors = [];
+        function __construct(public string $directory) { $this->settings = new TestSettings(); }
+        function getSysDir($name) { return $this->directory.'/'; }
+        function addError(...$args) { $this->errors[] = $args; return false; }
+    }
+    class TestSettings { function get($name) { return 99; } }
+}
+namespace {
+    define('HEURIST_ACTION_BLOCKED', 'blocked');
+    define('HEURIST_INVALID_REQUEST', 'invalid');
+    define('HEURIST_SYSTEM_CONFIG', 'config');
+    require_once __DIR__.'/../../hserv/synchronisation/SyncConfig.php';
+    $directory = sys_get_temp_dir().'/heurist-sync-config-test-'.bin2hex(random_bytes(8));
+    mkdir($directory);
+    $system = new \hserv\System($directory);
+    $service = new \hserv\synchronisation\SyncConfig($system);
+    function check($ok, $label) { if (!$ok) throw new \RuntimeException($label); echo "PASS: $label\n"; }
+    $config = ['role'=>'satellite','master'=>['databaseID'=>100,'database'=>'master','url'=>'https://example.org/heurist','sharedSecret'=>'test-only']];
+    try {
+        check($service->save($config),'Initial configuration saved');
+        $path = $directory.'/synchronisation.json';
+        check($service->updateRuntime(['lastMasterChangeReceived'=>25]),'Runtime cursor saved');
+        $config['master']['sharedSecret'] = '';
+        check($service->save($config),'Configuration edit preserves existing key');
+        $saved = json_decode(file_get_contents($path),true);
+        check($saved['lastMasterChangeReceived'] === 25 && $saved['master']['sharedKey'] === hash('sha256','test-only'),'Settings edit retains checkpoint and key');
+        $before = file_get_contents($path);
+        $config['master']['databaseID'] = 101;
+        check(!$service->save($config) && file_get_contents($path) === $before,'Different master cannot reuse configuration and maps');
+        file_put_contents($path,'{broken json');
+        check(!$service->updateRuntime(['lastMasterChangeReceived'=>26]) && file_get_contents($path)==='{broken json','Corrupt settings rejected without overwriting evidence');
+        $ref = new ReflectionMethod($service,'redact');
+        $redacted = $ref->invoke($service,['satellites'=>[['sharedKey'=>'must-not-leak']]]);
+        check(!isset($redacted['satellites'][0]['sharedKey']) && $redacted['satellites'][0]['hasSharedSecret'], 'Satellite keys removed from browser configuration');
+        check(count(glob($directory.'/.synchronisation-*'))===0,'Temporary files cleaned');
+    } finally {
+        foreach(glob($directory.'/*') as $file) unlink($file);
+        rmdir($directory);
+    }
+}
diff --git a/tests/synchronisation/file_regression.php b/tests/synchronisation/file_regression.php
