@@ -0,0 +1,20 @@
+<?php
+/** Real-filesystem check that repeat attempts never overwrite a previous upload. */
+require_once __DIR__.'/../../hserv/synchronisation/SyncFileStorage.php';
+use hserv\synchronisation\SyncFileStorage;
+$directory = sys_get_temp_dir().'/heurist-sync-files-'.bin2hex(random_bytes(8)).'/';
+mkdir($directory);
+try {
+    $first = SyncFileStorage::store($directory, 'sync_1_42', 'jpg', 'original image bytes');
+    $second = SyncFileStorage::store($directory, 'sync_1_42', 'jpg', 'different incoming image');
+    $empty = SyncFileStorage::store($directory, 'sync_1_43', 'txt', '');
+    if ($first === $second || file_get_contents($directory.$first) !== 'original image bytes'
+        || file_get_contents($directory.$second) !== 'different incoming image'
+        || filesize($directory.$empty) !== 0) throw new RuntimeException('File preservation failed');
+    echo "PASS: Repeated source identity produces separate immutable attempt files\n";
+    echo "PASS: Existing image bytes unchanged\n";
+    echo "PASS: Complete empty file stored correctly\n";
+} finally {
+    foreach(glob($directory.'*') as $file) unlink($file);
+    rmdir($directory);
+}
diff --git a/tests/synchronisation/remap_engine.sql b/tests/synchronisation/remap_engine.sql
new file mode 100644
index 0000000..575bc13
--- /dev/null
+++ b/tests/synchronisation/remap_engine.sql
@@ -0,0 +1,30 @@
+-- Isolated engine check of the parent-first two-stage remap order, not a full Heurist integration test.
+CREATE DATABASE IF NOT EXISTS heurist_sync_review_test;
+USE heurist_sync_review_test;
+DROP TABLE IF EXISTS test_links;
+DROP TABLE IF EXISTS test_details;
+DROP TABLE IF EXISTS test_records;
+DROP TABLE IF EXISTS test_assertions;
+CREATE TABLE test_records (id INT PRIMARY KEY) ENGINE=InnoDB;
+CREATE TABLE test_details (id INT PRIMARY KEY, record_id INT, pointer_value INT, image_id INT, FOREIGN KEY(record_id) REFERENCES test_records(id) ON UPDATE CASCADE) ENGINE=InnoDB;
+CREATE TABLE test_links (source_id INT, target_id INT, FOREIGN KEY(source_id) REFERENCES test_records(id) ON UPDATE CASCADE, FOREIGN KEY(target_id) REFERENCES test_records(id) ON UPDATE CASCADE) ENGINE=InnoDB;
+CREATE TABLE test_assertions (label VARCHAR(120), ok INT CHECK(ok=1)) ENGINE=InnoDB;
+CREATE TRIGGER sync_test_pointer AFTER UPDATE ON test_details FOR EACH ROW UPDATE test_links SET target_id=NEW.pointer_value WHERE source_id=NEW.record_id AND NEW.pointer_value IS NOT NULL;
+INSERT INTO test_records VALUES (1),(2);
+INSERT INTO test_details VALUES (100,1,2,42);
+INSERT INTO test_links VALUES (1,2);
+START TRANSACTION;
+UPDATE test_records SET id=101 WHERE id=1;
+UPDATE test_records SET id=102 WHERE id=2;
+UPDATE test_details SET pointer_value=102 WHERE pointer_value=2;
+UPDATE test_records SET id=10 WHERE id=101;
+UPDATE test_records SET id=20 WHERE id=102;
+UPDATE test_details SET pointer_value=20 WHERE pointer_value=102;
+COMMIT;
+INSERT INTO test_assertions SELECT 'Image and detail identity survive two-stage remap', COUNT(*)=1 FROM test_details WHERE id=100 AND record_id=10 AND pointer_value=20 AND image_id=42;
+INSERT INTO test_assertions SELECT 'Link target follows existing canonical parent', COUNT(*)=1 FROM test_links WHERE source_id=10 AND target_id=20;
+START TRANSACTION;
+INSERT INTO test_details VALUES (101,10,NULL,43);
+ROLLBACK;
+INSERT INTO test_assertions SELECT 'Rolled-back addition does not alter existing image', COUNT(*)=1 FROM test_details WHERE image_id=42;
+INSERT INTO test_assertions SELECT 'Rolled-back new image is absent', COUNT(*)=0 FROM test_details WHERE id=101;
