{
    "source": {
      "include": ["hclient","viewers"],
      "includePattern": ".+\\.js$",
      "excludePattern": "(^|\\/|\\\\)_"
    },
    "opts": {
      "destination": "../heurist_docs/jsdocs",
      "recurse": true,
      "template": "templates/default"
    },
    "templates": {
      "cleverLinks": false,
      "monospaceLinks": false,
      "default": {
        "outputSourceFiles": false
      }
    }    
}
