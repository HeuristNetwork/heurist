    {
      "name": "6. Modern definition API",
      "item": [
        {
          "name": "Record types collection",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('collection envelope exists', function () { pm.expect(body.items).to.be.an('array'); pm.expect(body.meta).to.be.an('object'); pm.expect(body.pagination).to.be.an('object'); });",
                  "pm.test('pagination contract', function () { pm.expect(body.pagination).to.have.all.keys('total','offset','limit','self','next'); });",
                  "pm.test('canonical entity is rectypes', function () { pm.expect(pm.response.json().meta.entity).to.eql('rectypes'); });"
